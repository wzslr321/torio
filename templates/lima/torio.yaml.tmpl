# TEMPLATE ONLY — Etap 0 musi potwierdzić fields i pinned image before use.
# Sekrety nie mogą znaleźć się w tym pliku.
arch: aarch64
cpus: {{CPUS}}
memory: {{MEMORY}}
disk: {{DISK}}

# Use a pinned, verified Linux arm64 image URL+digest after spike.
images:
  - location: "{{IMAGE_URL}}"
    arch: aarch64
    digest: "{{IMAGE_DIGEST}}"

# Deliberately no broad macOS home mount.
mounts:
  - location: "{{TRANSFER_FOLDER}}"
    mountPoint: "/mnt/hermes-transfer"
    writable: true

provision:
  - mode: system
    script: |
      # Generated trusted bootstrap path is inserted by torio.
      {{SYSTEM_BOOTSTRAP}}
