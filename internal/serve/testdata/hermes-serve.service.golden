[Unit]
Description=Torio loopback backend (torio serve)

[Service]
Type=simple
WorkingDirectory=/home/hermes/hermes-agent
Environment=HERMES_HOME=/home/hermes/.hermes
Environment="HERMES_ENVIRONMENT_HINT=This machine is managed by Torio. The user's private notes are one Markdown vault at /home/hermes/brain; there is no other vault, and no vault path to resolve from an environment variable or a fallback location. Read it with the torio-brain skill: search for the few notes that answer the question, then read those. Never list or read the vault in bulk."
ExecStart=/usr/local/bin/hermes serve --skip-build --host 127.0.0.1 --port 9119
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
