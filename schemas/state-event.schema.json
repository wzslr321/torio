{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-box.local/schemas/state-event.schema.json",
  "title": "Hermes Box append-only ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "actor", "task_id", "payload"],
  "properties": {
    "schema_version": {"const": "1"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["task.admitted", "execution.started", "execution.stopped", "candidate.created", "verification.completed", "approval.granted", "approval.revoked", "candidate.stale", "integration.completed", "push.completed", "task.discarded", "reconciliation.required"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "brain", "control-plane", "worker", "verifier"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "task_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"}
  }
}