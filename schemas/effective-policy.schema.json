{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torio.dev/schemas/effective-policy.schema.json",
  "title": "Torio effective execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "base_commit", "worker", "verifier", "workspace", "host_tools", "secrets", "integration"],
  "properties": {
    "schema_version": {"const": "1"},
    "project_id": {"type": "string"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "network", "cpu", "memory_mb", "timeout_seconds", "fresh_per_task", "persist_across_processes"],
      "properties": {
        "image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
        "network": {"enum": ["none", "project-internal", "unrestricted"]},
        "cpu": {"type": "number", "exclusiveMinimum": 0},
        "memory_mb": {"type": "integer", "minimum": 256},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "fresh_per_task": {"const": true},
        "persist_across_processes": {"const": false}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "network", "commands"],
      "properties": {
        "image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
        "network": {"enum": ["none", "project-internal"]},
        "commands": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "mount", "git_metadata", "repository_ancestor_reachable", "git_ceiling_directories", "extra_mounts"],
      "properties": {
        "kind": {"const": "materialized-tree"},
        "mount": {"const": "/workspace"},
        "git_metadata": {"const": "denied"},
        "repository_ancestor_reachable": {"const": false},
        "git_ceiling_directories": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "/workspace"}},
        "extra_mounts": {"type": "array", "maxItems": 0}
      }
    },
    "host_tools": {"type": "array", "uniqueItems": true, "items": {"enum": ["kanban-worker"]}},
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "secrets": {
      "type": "object", "additionalProperties": false,
      "required": ["env_allowlist", "credential_files"],
      "properties": {
        "env_allowlist": {"type": "array", "maxItems": 0},
        "credential_files": {"type": "array", "maxItems": 0}
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "target_ref", "push"],
      "properties": {
        "mode": {"const": "fast-forward-only"},
        "target_ref": {"type": "string", "pattern": "^refs/heads/"},
        "push": {"const": "explicit-human-only"}
      }
    }
  }
}